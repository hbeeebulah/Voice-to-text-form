# Server Port
PORT=5000

# Voice AI Speech Engine API Key for multimodal audio transcription
VOICE_AI_API_KEY=your_voice_ai_key_here

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 Web Client ID for Sign-In with Google
# Obtain from Google Cloud Console > APIs & Services > Credentials
# (Can also be set dynamically via the in-app Google OAuth Settings modal)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional Database Connections (defaults to persistent local JSON storage in server/data/)
# MONGODB_URI=mongodb://localhost:27017/voice_forms
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_forms
